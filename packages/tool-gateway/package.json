{
  "name": "@synapse/tool-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@synapse/contracts": "workspace:*",
    "@synapse/policy-engine": "workspace:*",
    "@synapse/safety-engine": "workspace:*",
    "@synapse/approval-engine": "workspace:*",
    "@synapse/capabilities": "workspace:*",
    "@synapse/evidence": "workspace:*",
    "@synapse/audit-engine": "workspace:*",
    "@synapse/event-bus": "workspace:*",
    "@synapse/observability": "workspace:*",
    "@synapse/secrets": "workspace:*",
    "@synapse/tenancy": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
