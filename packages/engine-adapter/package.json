{
  "name": "@synapse/engine-adapter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cline/agents": "*",
    "@cline/core": "*",
    "@cline/llms": "*",
    "@cline/shared": "*",
    "@synapse/contracts": "*",
    "@synapse/control-plane": "*",
    "@synapse/database": "*",
    "@synapse/simulation-engine": "*",
    "@synapse/tenancy": "*",
    "@synapse/tool-gateway": "*",
    "@synapse/twin-engine": "*",
    "@synapse/world-engine": "*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
